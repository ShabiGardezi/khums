# Khums web — copy to apps/web/.env.local for local development. Never commit real values.
#
# Two kinds of variables:
# - NEXT_PUBLIC_* are PUBLIC: Next.js bundles them into browser JavaScript. Never put secrets in
#   them. Validated in src/env.ts.
# - The staff sign-in variables below are SERVER-ONLY (no NEXT_PUBLIC_ prefix, so they are never
#   sent to the browser). Validated at request time in src/server/staff-auth-env.ts. They are
#   needed only for the staff console (/{locale}/admin); the public calculator works without
#   them. Set all six or none.

# Public base URL of the web app (metadata / canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the shared Khums REST API, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Staff console (M4.6.2b) — SERVER-ONLY ------------------------------------------------------
# Origin of the Khums API that /api/v1/* is rewritten to (transport only; the API authenticates
# and authorizes). Read when BUILDING (Next.js rewrites are build-time) and by server code.
# Local development defaults to http://localhost:4000. Production: an exact https:// origin.
# Staff sign in with a username and password issued by a SUPER_ADMIN; there is no Auth0 staff path.
KHUMS_API_ORIGIN=http://localhost:4000
# Client IP for staff sign-in throttling (M4.6.2b): the header Vercel overwrites at its edge, and
# the secret shared with the API (STAFF_EDGE_SECRET there). On Vercel both are REQUIRED (the
# /api/v1 proxy answers 503 without them). Leave both empty for local development.
KHUMS_CLIENT_IP_HEADER=
STAFF_EDGE_SECRET=

# --- Operational state and private access (M4.5a / M4.7) — SERVER-ONLY ----------------------------
# DEVELOPMENT | SCHOLAR_REVIEW | PRODUCTION_APPROVED. Empty: DEVELOPMENT under `next dev` only.
KHUMS_OPERATIONAL_STATE=
# Whole-application private gate: SCHOLAR_REVIEW is always private, and every hosted (Vercel)
# deployment is private unless it is PRODUCTION_APPROVED with KHUMS_PUBLIC_ACCESS=enabled (the
# public launch, a separate approval). `required` forces the gate anywhere. Leave both empty.
KHUMS_PRIVATE_ACCESS=
KHUMS_PUBLIC_ACCESS=
