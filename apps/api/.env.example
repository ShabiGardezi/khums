# Khums API — local development configuration.
# Copy to apps/api/.env (git-ignored). Real secrets never go in this file or in git.
# In production, set these through the hosting platform's secret store; .env is NOT loaded
# when NODE_ENV=production. All values are validated at startup (src/config/env.schema.ts).

# development | test | production
NODE_ENV=development

# Network interface and port the HTTP server binds to.
HOST=0.0.0.0
PORT=4000

# Comma-separated list of browser origins allowed to call the API (exact origins, no paths).
# Native mobile apps do not need CORS. In production every origin must be https://.
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# json (production) | pretty (local development only)
LOG_FORMAT=pretty

# Serve Swagger UI at /api/docs (defaults to false when NODE_ENV=production).
SWAGGER_ENABLED=true

# Set to true only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# MongoDB connection string (M4.6.3a). Secret: set it in the platform's secret store, never in git.
# The API runtime connects as the least-privilege `khumsApp` user (insert/find only on history;
# see docs/DATABASE_SCHEMA.md §3.9). Unset: production stores are unavailable (fail closed) and
# development/test use process memory.
# Local example: mongodb://localhost:27017/?replicaSet=rs0
# Atlas example: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# Local development against MEMORY (never the real database): start with `MONGODB_URI= pnpm dev`.
# OpenAPI generation and the printers never read this file or a MONGODB_URI (M5.3.3 R4).
MONGODB_URI=
# Database name inside the cluster (default: khums).
MONGODB_DATABASE=khums
# NOTE: AUDIT_CHECKPOINT_SIGNING_KEY belongs ONLY to the checkpoint job (apps/api/README.md).
# The API server refuses to start if it is present in its environment.

# --- Staff authentication (username/password, server-side sessions, M4.6.2b) -------------------
# Needed only for staff routes; public routes never require authentication. Without a secret in
# production, staff routes refuse every request (503). Staff browsers reach the API through the web
# origin's /api/v1 rewrite; CORS_ORIGINS above also lists the web origins allowed to send unsafe
# staff requests (Origin + Sec-Fetch-Site + CSRF token checks).
# Shared with the web app (same value there). The web tier signs the client IP it takes from
# Vercel's edge header; the API trusts nothing else (never X-Forwarded-For). SECRET, ≥ 32
# characters. REQUIRED in production, otherwise staff routes refuse every request.
STAFF_EDGE_SECRET=
# M4.7 private deployment: answer only requests the web tier signed with STAFF_EDGE_SECRET (every
# route except GET /api/v1/health). REQUIRED (true) for a production SCHOLAR_REVIEW or
# PRODUCTION_APPROVED deployment (decision 65: staff test provisional packs there too).
KHUMS_REQUIRE_EDGE_SIGNATURE=false
# HMAC key for sign-in throttle keys. SECRET, at least 32 characters (openssl rand -base64 48).
# Development without it uses a random per-process key.
STAFF_AUTH_SECRET=
# __Host- Secure cookies. Must be true in production; set false only for plain-http development
# in browsers that refuse Secure cookies on http://localhost.
STAFF_COOKIE_SECURE=true
# Session limits: idle minutes (5–120) and absolute hours (1–24).
STAFF_SESSION_IDLE_MINUTES=30
STAFF_SESSION_ABSOLUTE_HOURS=8
# TEST ONLY (Playwright): path of apps/api/test/fixtures/e2e-staff.json, seeded into memory.
# Refused in production and together with MONGODB_URI. Leave empty.
STAFF_E2E_FIXTURE_FILE=
# The first SUPER_ADMIN is created once with: node dist/main.js --bootstrap-super-admin <username>
# (interactive password prompt; never put a password in this file).

# Operational state (M4.5a): DEVELOPMENT | SCHOLAR_REVIEW | PRODUCTION_APPROVED. Empty means
# DEVELOPMENT in development/test and unconfigured in production (provisional actions refused).
# DEVELOPMENT is refused in production. Provisional calculations run only for signed-in staff in
# SCHOLAR_REVIEW and PRODUCTION_APPROVED (decision 65); PRODUCTION_APPROVED also serves verified
# packs to the public calculator (GET /api/v1/public/marjas).
KHUMS_OPERATIONAL_STATE=

# Evidence storage (M5.3.3). Development and maintainer machines ONLY: AES-256-GCM files in a
# directory on a persistent, encrypted, backed-up disk. Refused in production (the private
# deployment's filesystem is ephemeral; evidence uploads answer 503 there). Set both or neither.
# Generate the key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never commit the key; keep a copy in your password manager (without it the files cannot be read).
KHUMS_EVIDENCE_DIR=
KHUMS_EVIDENCE_KEY=

# Pre-production reset family (--reset-integration-test-run, --verify/--restore-preproduction-backup,
# --lift-maintenance-fence): KHUMS_BACKUP_KEY (base64 of 32 bytes) is given to THAT command only,
# e.g. `read -rs KHUMS_BACKUP_KEY && export KHUMS_BACKUP_KEY` in the operator's shell. Never put it
# in this file: the API refuses to start while it is set. Keep it in the password manager.
